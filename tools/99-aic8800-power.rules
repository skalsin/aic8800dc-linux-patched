# Disable USB autosuspend and power saving for AIC8800 Wi-Fi adapter
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="3625", ATTR{idProduct}=="0110", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="3625", ATTR{idProduct}=="0110", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="2357", ATTR{idProduct}=="0147", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="2357", ATTR{idProduct}=="0147", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
